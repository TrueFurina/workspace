{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "⑥ 鲶鱼对抗式复核 输出 Schema",
  "type": "object",
  "required": [
    "self_reviewed_previous",
    "counter_hypotheses"
  ],
  "properties": {
    "self_reviewed_previous": {
      "type": "boolean",
      "const": true,
      "description": "必须显式审查上一轮输出，不得自我背书"
    },
    "counter_hypotheses": {
      "type": "array",
      "description": "结论高度自洽时强制构造至少一个对立假设",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "hypothesis": {
            "type": "string"
          },
          "evidence_for": {
            "type": "string"
          },
          "evidence_against": {
            "type": "string"
          }
        },
        "required": [
          "hypothesis"
        ]
      }
    },
    "metrics_verified": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "claimed": {
            "type": [
              "number",
              "string"
            ]
          },
          "recomputed": {
            "type": [
              "number",
              "string"
            ]
          },
          "match": {
            "type": "boolean"
          }
        }
      }
    },
    "revision": {
      "type": "string"
    }
  }
}