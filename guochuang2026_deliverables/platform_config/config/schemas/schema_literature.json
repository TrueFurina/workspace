{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "① 文献调研 Agent 输出 Schema",
  "type": "object",
  "required": [
    "queries",
    "citations"
  ],
  "properties": {
    "queries": {
      "type": "array",
      "description": "检索式留痕，可复算",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "returned": {
            "type": "integer"
          }
        },
        "required": [
          "source",
          "query"
        ]
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "doi": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "claim": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          }
        },
        "required": [
          "doi",
          "claim"
        ]
      }
    },
    "summary": {
      "type": "string"
    },
    "insufficient_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "缺失来源据实列出，不得补编"
    }
  }
}